# Copy this file to .env and fill in the values. Never commit .env (it is git-ignored).
# Every value below is the server's default (server/src/env.ts) unless marked as required.

# ─── Server ──────────────────────────────────────────────────────────────────
# Port of the Express API (Vite proxies /api to it in development)
PORT=3000

# Public URL of this app as opened in the browser (Vite dev server by default).
# Behind Nginx on a subpath, include it: APP_URL=https://www.example.com/castle
APP_URL=http://localhost:5173

# ─── Git ───────────────────────────────────────────────────────────────────
# REQUIRED: URL of your Git instance
GIT_URL=https://git.example.com

# REQUIRED: personal access token (Git → Settings → Applications → Generate New Token)
# Scopes: read:repository, read:user, read:organization. Use an admin account's token so
# /admin/emails can list every user's secondary emails (better commit matching).
GIT_TOKEN=

# ─── Git Live Sync ──────────────────────────────────────────────────────────
# How often Git data (new repos, commits, PRs) is re-pulled in the background, in hours.
# Minimum 1 (lower values are raised to 1). Example: 1 = every 1 hour.
GIT_SYNC_INTERVAL_HOURS=1
# Rolling window for the live head sync, in days (default: 3 days = 72 hours)
LIVE_SYNC_LOOKBACK_DAYS=3

# ─── Historical Backfill Walker ───────────────────────────────────────────────
# Enable or disable background historical backfill
BACKFILL_ENABLED=true
# Starting year for historical walk (starts Jan 1st 00:00:00 UTC of that year)
BACKFILL_START_YEAR=2020
# Gentle pause between repos in ms (keeps CPU & Git load near zero)
BACKFILL_DELAY_MS=500
# Set to 'true' if you want to wipe checkpoint and reprocess from BACKFILL_START_YEAR again
BACKFILL_FORCE_RESET=false

# Max buildings per kingdom (a developer's top repositories)
GIT_MAX_BUILDINGS=100

# The internal Git uses a certificate chain Node can't verify, so the server sets this to 0
# when it isn't set. Set it to 1 if your Git has a valid certificate.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── Sign in with Git (OAuth2) ─────────────────────────────────────────────
# Needed for players to manage their own kingdom (garrison, marches, caravans, swaps, improvements).
# Create an OAuth2 application in Git: Settings → Applications → Manage OAuth2 Applications
# Redirect URI must be: <APP_URL>/api/auth/callback   (e.g. http://localhost:5173/api/auth/callback)
GIT_OAUTH_CLIENT_ID=
GIT_OAUTH_CLIENT_SECRET=

# Login is a must: without a session every API route (kingdoms, repos, developer names) answers 401
# and visitors only see the login screen. Set to true ONLY on a local machine to let signed-out
# visitors browse ("Look around without signing in"), e.g. to check visuals. Anything but "true" = off.
GUEST_BROWSING=false

# ─── Roles ───────────────────────────────────────────────────────────────────
# Special Users (managers / trackers) permanently locked to Nethergarde Voidrift as max-level overseers.
# Comma-separated Git logins (e.g. manager1,tracker1). The old name NETHERGARDE_USERS still works.
SPECIAL_USERS=

# The Archon of the Realm (department head): everything a Special Overseer has, plus untouchable,
# a Lv30 Empyrean citadel at the heart of the Voidrift and 50 Lv30 buildings. Comma-separated
# Git logins; don't also list them in SPECIAL_USERS.
ARCHON_USERS=

# Administrators with access to the admin controls (instant harvest, respawn, world reset,
# re-check a developer's commits). Comma-separated Git logins (e.g. admin1,admin2)
ADMIN_USERS=

# ─── Game rules ──────────────────────────────────────────────────────────────
# Resource harvest interval in minutes (independent of the Git sync)
SYNC_INTERVAL_MINUTES=15

# Natural lifespan of a 1.0× civilization (humans) in hours; sets every civ's death rate
BASE_LIFESPAN_HOURS=24

# Nethergarde Voidrift slots open to mortal developers; empty slots are held by NPC void kingdoms
NETHERGARDE_PLAYER_SLOTS=3
